# Google Play Android application ID
GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.soulboundlegends

# Production: configure Google authenticated Developer API credentials here using
# your secure secret manager. NEVER put these values in Unity.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/secure/path/google-play-service-account.json

# Google Play RTDN / Pub/Sub configuration is environment-specific.
GOOGLE_PLAY_RTDN_TOPIC=
GOOGLE_PLAY_RTDN_SUBSCRIPTION=

# Development only. Leave false/undefined in production.
SBL_ALLOW_COMMERCE_DEV_STUB=false
